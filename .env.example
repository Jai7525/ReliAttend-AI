# ReliAttend AI — Environment Configuration Template
# Duplicate this file as .env and fill in values for local development or Docker.

# Application Settings
APP_NAME="ReliAttend AI Backend"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
HOST="127.0.0.1"
PORT=8000

# Security (Phase 3)
SECRET_KEY="generate-a-secure-random-secret-key-for-jwt-signing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Phase 2)
# For local host runs: sqlite:///./reliattend.db
# For Docker runs: sqlite:////app/data/reliattend.db
DATABASE_URL="sqlite:///./reliattend.db"

# Storage Configuration
# For local host runs: ./storage
# For Docker runs: /app/storage
STORAGE_PATH="./storage"

# Biometric & Computer Vision Configuration (Phase 6)
# Paths:
BIOMETRIC_MODELS_DIR="./backend/models"
BIOMETRIC_STORAGE_DIR="./storage/reference_images"

# File Upload Limits & Thresholds:
BIOMETRIC_MAX_UPLOAD_BYTES=5242880
BIOMETRIC_YUNET_CONFIDENCE_THRESHOLD=0.85
BIOMETRIC_MIN_FACE_WIDTH=80
BIOMETRIC_MIN_FACE_HEIGHT=80
BIOMETRIC_BLUR_THRESHOLD=50.0
BIOMETRIC_MIN_BRIGHTNESS=40.0
BIOMETRIC_MAX_BRIGHTNESS=220.0
