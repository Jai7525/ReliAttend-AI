# ReliAttend AI — Environment Configuration Template
# Duplicate this file as .env and fill in values for local development.

# Application Settings
APP_NAME="ReliAttend AI Backend"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
HOST="127.0.0.1"
PORT=8000

# Security (Phase 3)
SECRET_KEY="generate-a-secure-random-secret-key-for-jwt-signing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Phase 2)
DATABASE_URL="sqlite:///./reliattend.db"

# Storage Configuration
STORAGE_PATH="./storage"

