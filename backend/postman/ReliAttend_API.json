    {
      "name": "03 - Student Management",
      "description": "Student registration, student list filtering, profiles, and biometric consent logging.",
      "item": [
        {
          "name": "1. Register Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () { pm.response.to.have.status(201); });",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) { pm.collectionVariables.set(\"student_pk\", jsonData.data.id.toString()); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": \"STU2026_001\",\n  \"name\": \"Aarav Patel\",\n  \"roll_number\": \"26CS001\",\n  \"class_section_id\": {{class_id}}\n}"
            },
            "url": { "raw": "{{api_v1}}/students", "host": ["{{api_v1}}"], "path": ["students"] }
          }
        },
        {
          "name": "2. Register Student (Duplicate ID - Negative Test)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409 Conflict\", function () { pm.response.to.have.status(409); });"
