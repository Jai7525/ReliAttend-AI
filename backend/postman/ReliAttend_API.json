      "name": "Phase 7: Multi-Face Detection",
      "item": [
        {
          "name": "13. Detect Faces in Classroom Group Frame",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response structure contains face count and detection metadata', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.have.property('face_count');",
                  "    pm.expect(jsonData.data).to.have.property('frame_metadata');",
                  "    pm.expect(jsonData.data).to.have.property('faces');",
                  "    pm.expect(jsonData.data.frame_metadata).to.have.property('width');",
                  "    pm.expect(jsonData.data.frame_metadata).to.have.property('height');",
                  "    pm.expect(jsonData.data.frame_metadata).to.have.property('inference_time_ms');",
                  "});",
                  "pm.test('Verify landmarks and quality metrics on detected faces', function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data.face_count > 0) {",
                  "        var firstFace = jsonData.data.faces[0];",
                  "        pm.expect(firstFace).to.have.property('bounding_box');",
                  "        pm.expect(firstFace).to.have.property('confidence');",
                  "        pm.expect(firstFace).to.have.property('landmarks');",
                  "        pm.expect(firstFace).to.have.property('quality');",
                  "        pm.expect(firstFace.landmarks).to.have.property('right_eye');",
                  "        pm.expect(firstFace.landmarks).to.have.property('left_eye');",
                  "        pm.expect(firstFace.landmarks).to.have.property('nose_tip');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
