            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": \"STU2026_001\",\n  \"name\": \"Duplicate Person\",\n  \"roll_number\": \"26CS999\",\n  \"class_section_id\": {{class_id}}\n}"
